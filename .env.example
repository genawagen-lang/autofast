# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override default model IDs
OPENAI_DISCOVERY_MODEL=gpt-4o-mini
OPENAI_BUILDER_MODEL=gpt-4o

# ─── n8n ─────────────────────────────────────────────────────────────────────
# stub = simulate n8n responses locally; live = real n8n instance
N8N_MODE=stub
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# ─── Google OAuth (for Google Sheets credential flow) ───────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Telegram ────────────────────────────────────────────────────────────────
# Optional — only needed if Telegram send actions are used
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
